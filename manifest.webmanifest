<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <meta name="description" content="Paperwork Lite offline workspace" />
    <title>Paperwork Lite</title>
    <link rel="manifest" href="./manifest.webmanifest" />
    <link rel="icon" href="./assets/icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="./css/styles.css" />
  </head>
  <body>
    <div id="app" class="app-shell">
      <aside id="sidebar" class="sidebar">
        <div class="sidebar-header">
          <div class="brand">
            <div class="brand-mark">P</div>
            <div>
              <strong>Paperwork</strong>
              <small>Lite</small>
            </div>
          </div>
          <button id="sidebarToggle" class="icon-button" aria-label="Toggle sidebar">☰</button>
        </div>

        <div class="sidebar-section">
          <div class="nav-group">
            <button class="nav-item active" data-view="home">🏠 Home</button>
            <button class="nav-item" data-view="workspace">🗂️ Workspace</button>
            <button class="nav-item" data-view="portfolio">🎨 Portfolio</button>
            <button class="nav-item" data-view="vault">🔒 Vault</button>
          </div>
        </div>

        <div class="sidebar-section">
          <div class="section-title-row">
            <span>Workspace</span>
            <button id="newFolderBtn" class="mini-button">+ Folder</button>
          </div>
          <div id="workspaceTree" class="tree"></div>
        </div>

        <div class="sidebar-section">
          <div class="section-title-row"><span>Shortcuts</span></div>
          <div class="nav-group compact">
            <button class="nav-item" data-action="search">⌕ Search</button>
            <button class="nav-item" data-action="favorites">⭐ Favorites</button>
            <button class="nav-item" data-action="stats">📊 Stats</button>
            <button class="nav-item" data-action="lock">🔐 Lock</button>
          </div>
        </div>
      </aside>

      <main class="main-panel">
        <header class="topbar">
          <div id="breadcrumbs" class="breadcrumbs"></div>
          <div class="toolbar">
            <button id="backBtn" class="icon-button" aria-label="Back">←</button>
            <button id="forwardBtn" class="icon-button" aria-label="Forward">→</button>
            <button id="upBtn" class="icon-button" aria-label="Up">↑</button>
            <button id="homeBtn" class="icon-button" aria-label="Home">⌂</button>
            <button id="themeToggle" class="icon-button" aria-label="Toggle theme">☼</button>
            <button id="focusModeToggle" class="icon-button" aria-label="Focus mode">◐</button>
            <button id="mobileToggle" class="icon-button" aria-label="Mobile view">📱</button>
            <button id="searchButton" class="action-button">⌘K</button>
          </div>
        </header>

        <section id="homeArea" class="content-area visible">
          <div class="content-header">
            <div>
              <h1>Home</h1>
              <div id="autosaveIndicator" class="autosave-status">Autosave: ready</div>
            </div>
            <div class="header-actions">
              <button id="newNoteBtn" class="action-button secondary">New Note</button>
              <button id="importBtn" class="action-button secondary">Import</button>
              <button id="exportBtn" class="action-button secondary">Export</button>
            </div>
          </div>

          <div class="dashboard-grid">
            <div class="stat-card">
              <span>Notes</span>
              <strong id="statNotes">0</strong>
            </div>
            <div class="stat-card">
              <span>Folders</span>
              <strong id="statFolders">0</strong>
            </div>
            <div class="stat-card">
              <span>Favorites</span>
              <strong id="statFavorites">0</strong>
            </div>
            <div class="stat-card">
              <span>Portfolio Pages</span>
              <strong id="statPortfolioPages">0</strong>
            </div>
          </div>

          <div class="activity-panel">
            <h3>Recent notes</h3>
            <div id="recentList" class="list-block"></div>
          </div>

          <div id="companionArea" class="companion-panel"></div>
        </section>

        <section id="workspaceArea" class="content-area hidden">
          <div class="content-header">
            <div>
              <h1 id="currentTitle">Workspace</h1>
              <div id="workspaceStatus" class="autosave-status">Local workspace</div>
            </div>
            <div class="header-actions">
              <button id="workspaceNewNoteBtn" class="action-button secondary">New Note</button>
            </div>
          </div>

          <div class="workspace-view">
            <div id="fileList" class="file-list"></div>

            <div id="editorPanel" class="editor-panel">
              <div id="editorTabs" class="editor-tabs"></div>

              <div class="editor-toolbar">
                <select id="languageSelect"></select>
                <button id="formatBtn" class="mini-button">Format</button>
                <button id="previewBtn" class="mini-button">Preview</button>
                <button id="insertChecklistBtn" class="mini-button">Checklist</button>
                <button id="insertTableBtn" class="mini-button">Table</button>
                <button id="insertCodeBtn" class="mini-button">Code</button>
              </div>

              <div class="editor-surface">
                <div id="lineNumbers" class="line-numbers" aria-hidden="true"></div>
                <pre id="editorHighlight" class="editor-highlight" aria-hidden="true"></pre>
                <textarea id="editorInput" spellcheck="false" aria-label="Editor content"></textarea>
              </div>

              <div id="searchReplacePanel" class="search-panel hidden">
                <input id="searchInput" type="text" placeholder="Find..." />
                <input id="replaceInput" type="text" placeholder="Replace..." />
                <button id="findNextBtn" class="mini-button">Find</button>
                <button id="replaceBtn" class="mini-button">Replace</button>
                <button id="replaceAllBtn" class="mini-button">Replace all</button>
              </div>
            </div>
          </div>
        </section>

        <section id="portfolioArea" class="content-area hidden">
          <div class="portfolio-header">
            <h2>Portfolio Studio</h2>
            <div class="header-actions">
              <button id="portfolioAddPageBtn" class="action-button secondary">Add page</button>
              <button id="portfolioPreviewBtn" class="action-button secondary">Preview</button>
              <button id="portfolioExportBtn" class="action-button secondary">Export client</button>
            </div>
          </div>

          <div class="portfolio-layout">
            <aside class="portfolio-panel">
              <div id="portfolioPages" class="portfolio-pages"></div>
            </aside>
            <main class="portfolio-editor">
              <div id="portfolioBuilder" class="portfolio-builder"></div>
            </main>
          </div>
        </section>

        <section id="vaultArea" class="content-area hidden">
          <div class="vault-header">
            <h2>Private Vault</h2>
            <div class="header-actions">
              <button id="vaultUnlockBtn" class="action-button">Unlock</button>
              <button id="vaultAddBtn" class="action-button secondary">Add item</button>
            </div>
          </div>
          <div id="vaultGrid" class="vault-grid"></div>
        </section>
      </main>
    </div>

    <div id="commandPalette" class="palette hidden" role="dialog" aria-modal="true">
      <div class="palette-panel">
        <div class="palette-header">
          <input id="paletteInput" type="text" placeholder="Search commands, notes, pages..." />
        </div>
        <div id="paletteResults" class="palette-results"></div>
      </div>
    </div>

    <div id="authModal" class="modal hidden" role="dialog" aria-modal="true">
      <div class="modal-card">
        <h3 id="authTitle">Master password</h3>
        <p id="authSubtitle">Unlock the workspace and private vault.</p>
        <input id="authInput" type="password" placeholder="Password" />
        <div class="modal-actions">
          <button id="authSubmitBtn" class="action-button">Unlock</button>
          <button id="authCancelBtn" class="action-button secondary">Cancel</button>
        </div>
      </div>
    </div>

    <div id="settingsModal" class="modal hidden" role="dialog" aria-modal="true">
      <div class="modal-card wide">
        <h3>Settings</h3>
        <div class="settings-grid">
          <label>
            Theme
            <select id="themeSelect">
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </label>
          <label>
            Layout
            <select id="layoutSelect">
              <option value="desktop">Desktop</option>
              <option value="mobile">Mobile</option>
            </select>
          </label>
          <label>
            Auto-lock minutes
            <input id="autoLockMinutes" type="number" min="1" max="180" value="20" />
          </label>
        </div>
        <div class="modal-actions">
          <button id="saveSettingsBtn" class="action-button">Save</button>
          <button id="closeSettingsBtn" class="action-button secondary">Close</button>
        </div>
      </div>
    </div>

    <div id="toast" class="toast hidden"></div>

    <script src="./js/linguist-registry.js"></script>
    <script src="./js/app.js"></script>
  </body>
</html>
